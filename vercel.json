{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@growthos_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@growthos_supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@growthos_supabase_service_role_key",
    "ANTHROPIC_API_KEY": "@growthos_anthropic_api_key",
    "OPENAI_API_KEY": "@growthos_openai_api_key",
    "GEMINI_API_KEY": "@growthos_gemini_api_key",
    "STRIPE_SECRET_KEY": "@growthos_stripe_secret_key",
    "STRIPE_WEBHOOK_SECRET": "@growthos_stripe_webhook_secret",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "@growthos_stripe_publishable_key"
  }
}
